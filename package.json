{
  "name": "lightborn",
  "description": "A moddable Emergency Lighting System for Roblox.",
  "scripts": {
    "cm": "cz",
    "prepare": "husky"
  },
  "packageManager": "bun",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && bunx cz --hook || true"
    }
  }
}
